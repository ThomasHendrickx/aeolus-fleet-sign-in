{
  "name": "@aeolus-fleet/sign-in",
  "version": "0.0.0",
  "description": "Aeolus sign-in: signs people in to a self-hosted Aeolus fleet.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThomasHendrickx/aeolus-fleet-sign-in.git",
    "directory": "packages/sign-in"
  },
  "bugs": {
    "url": "https://github.com/ThomasHendrickx/aeolus-fleet/issues"
  },
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "@aeolus-fleet/common": "^0.39.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "fastify": "^5.12.8",
    "jose": "^6.2.17",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "bin": {
    "aeolus-sign-in": "dist/bin/aeolus-sign-in.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json && cp -R src/adapters/http/assets dist/adapters/http/ && cp -R src/adapters/prisma/migrations dist/adapters/prisma/",
    "start": "node dist/bin/aeolus-sign-in.js serve"
  }
}
